# Server
NODE_ENV=development
PORT=4000

# Database (SQLite for local dev)
DB_PATH=./data/kisanconnect.db

# PostgreSQL connection used ONLY when DB_DRIVER=postgres (production)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/kisanconnect

DB_DRIVER=sqlite

# Auth
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_EXPIRES=30d

# OTP
OTP_DIGITS=4
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_WINDOW_MS=60000
OTP_RATE_LIMIT_MAX=3
# In development the generated OTP is returned in the API response so the app
# can be demoed end-to-end without an SMS gateway. Disable in production.
OTP_DEV_MODE=true

# SMS Provider Configuration
# Supported providers: msg91, twilio, textlocal
SMS_PROVIDER=msg91
SMS_API_KEY=
SMS_AUTH_KEY=
SMS_SENDER_ID=KISAN
SMS_TEMPLATE_ID=
SMS_USERNAME=
SMS_PASSWORD=
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM=

# Notifications (Firebase Cloud Messaging - optional, stub used without creds)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Service defaults
DEFAULT_AVG_PROCESS_MINUTES=10
DEFAULT_ACTIVE_COUNTERS=1

# ML service (FastAPI - wait-time prediction + center recommendations)
ML_SERVICE_URL=http://localhost:8001