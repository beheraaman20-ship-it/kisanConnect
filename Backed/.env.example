# Server
NODE_ENV=development
PORT=4000

# Database (SQLite for local dev)
DB_PATH=./data/kisanconnect.db

# PostgreSQL connection used ONLY when DB_DRIVER=postgres (production)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/kisanconnect

DB_DRIVER=sqlite

# Auth
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_EXPIRES=30d

# OTP
OTP_DIGITS=4
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_WINDOW_MS=60000
OTP_RATE_LIMIT_MAX=3
# In development the generated OTP is returned in the API response so the app
# can be demoed end-to-end without an SMS gateway. Disable in production.
OTP_DEV_MODE=true
OTP_PROVIDER_KEY=

# Notifications (Firebase Cloud Messaging - optional, stub used without creds)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Service defaults
DEFAULT_AVG_PROCESS_MINUTES=10
DEFAULT_ACTIVE_COUNTERS=1

# ML service (optional, future)
ML_SERVICE_URL=