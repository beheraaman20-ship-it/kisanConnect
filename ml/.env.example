# ML Service Environment Configuration
# Copy to .env and fill in real values. Never commit secrets.

# App
APP_NAME=Smart Farmer Procurement ML Service
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Database (SQLite = reads the backend's kisanconnect.db directly; no install needed)
# For PostgreSQL deployment, use: postgresql+psycopg2://postgres:postgres@localhost:5432/kisanconnect
DATABASE_URL=sqlite:///C:/KisanConnectBackend/data/kisanconnect.db
ASYNC_DATABASE_URL=

# Model storage paths
MODEL_DIR=saved_models
WAIT_TIME_MODEL_PATH=saved_models/wait_time_model.pkl
RECOMMEND_MODEL_PATH=saved_models/center_recommend_model.pkl

# Model config
RANDOM_STATE=42
TEST_SIZE=0.2
